{
  "name": "image-classification-service",
  "version": "1.0.0",
  "description": "AI-powered image classification service using Node.js and Cohere",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "docker:build": "docker build -t image-classification-service .",
    "docker:run": "docker run -p 3000:3000 --env-file .env image-classification-service",
    "docker:compose": "docker-compose up --build"
  },
  "dependencies": {
    "@hapi/hapi": "^21.1.0",
    "@hapi/inert": "^7.1.1",
    "@hapi/joi": "^17.1.1",
    "axios": "^1.13.5",
    "cohere-ai": "^7.7.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.4",
    "multipart": "^0.1.0",
    "sharp": "^0.33.5"
  },
  "overrides": {
    "axios": "$axios",
    "form-data": "$form-data",
    "@hapi/wreck": "^18.1.0",
    "@hapi/content": "^6.0.0",
    "fast-xml-parser": "^4.5.4",
    "qs": "^6.14.2",
    "follow-redirects": "^1.15.6",
    "convict": "^6.2.4",
    "picomatch": "^2.3.1",
    "minimatch": "^3.1.4",
    "@smithy/config-resolver": "^4.4.0",
    "mime": "^1.6.0",
    "uuid": "^9.0.1",
    "brace-expansion": "^1.1.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
