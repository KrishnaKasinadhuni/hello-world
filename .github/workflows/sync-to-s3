name: Run Bash Script on Push

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  run_script:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Run Bash Script if present
        env:
          ENVIRONMENT: ${{ vars.ENVIRONMENT || 'dev' }}
        run: |
          if [[ -f "./script.sh" ]]; then
            chmod +x "./script.sh"
            "./script.sh" "$ENVIRONMENT"
          fi
